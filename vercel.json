{
  "version": 2,
  "routes": [
    {
      "src": "/api/auth/login",
      "dest": "/api/auth/login.py"
    },
    {
      "src": "/api/auth/logout",
      "dest": "/api/auth/logout.py"
    },
    {
      "src": "/api/auth/me",
      "dest": "/api/auth/me.py"
    },
    {
      "src": "/api/colaboradores/([0-9]+)/inativar",
      "dest": "/api/colaboradores.py"
    },
    {
      "src": "/api/colaboradores/([0-9]+)/reativar",
      "dest": "/api/colaboradores.py"
    },
    {
      "src": "/api/colaboradores/([0-9]+)",
      "dest": "/api/colaboradores.py"
    },
    {
      "src": "/api/colaboradores",
      "dest": "/api/colaboradores.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}
