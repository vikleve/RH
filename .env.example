# ─────────────────────────────────────────────────────────────
# Configuracao do Banco de Dados PostgreSQL — RH/DP
# ─────────────────────────────────────────────────────────────
# Copie este arquivo para ".env" e preencha com suas credenciais.
# O arquivo ".env" NAO deve ser enviado para o controle de versao.
# ─────────────────────────────────────────────────────────────

# Opcao 1: URL completa (recomendado para Supabase, Railway, Render, Neon, etc.)
# DATABASE_URL=postgresql://usuario:senha@host:5432/nome_banco

# Opcao 2: Variaveis individuais (para PostgreSQL local)
PGHOST=localhost
PGPORT=5432
PGDATABASE=rh_db
PGUSER=postgres
PGPASSWORD=sua_senha_aqui

# Senha do administrador inicial (criada na primeira inicializacao do banco)
# Se nao definida, o padrao sera: Admin@RH2026!
# ADMIN_INITIAL_PASSWORD=Admin@RH2026!
