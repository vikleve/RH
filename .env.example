# ==============================================================================
# .env.example — Modelo de Variáveis de Ambiente (Governança & Segurança)
# Instruções: Copie este arquivo para '.env' e configure seus valores locais.
# ATENÇÃO: NUNCA versione o arquivo '.env' real com credenciais de produção.
# ==============================================================================

# Porta do Servidor Web Local (Padrão: 8000)
PORT=8000

# Caminho do Banco de Dados SQLite Local (Desenvolvimento / Testes)
DB_PATH=colaboradores.db

# Credenciais Iniciais de Administrador (OBRIGATÓRIO na primeira inicialização)
# Defina uma senha forte antes de iniciar o sistema pela primeira vez.
# O sistema falhará a inicialização se executado em ambiente real sem esta configuração.
ADMIN_INITIAL_PASSWORD=

# Credenciais Opcionais para Usuário Visitante/Convidado (Analista de RH)
# Se não for configurada, a conta de visitante não será provisionada.
GUEST_INITIAL_PASSWORD=

# Integração com Banco de Dados PostgreSQL / Supabase (Opcional - Dual-Mode)
# Formato: postgresql://postgres:[SUA_SENHA]@[HOST]:5432/postgres
# DATABASE_URL=

# Configuração de Ambiente ('development', 'staging', 'production')
ENVIRONMENT=development

# NOTA SOBRE GESTÃO DE SESSÕES (Governança & Conformidade):
# As sessões de usuário utilizam tokens criptográficos de 32 bytes gerados aleatoriamente
# via secrets.token_hex(32) e são persistidas e controladas na tabela 'sessoes' com
# revogação e tempo de expiração explícitos. Não são utilizados segredos simétricos estáticos.
