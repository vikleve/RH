# ==============================================================================
# .env.example — Modelo de Variáveis de Ambiente (Governança & Segurança)
# Instruções: Copie este arquivo para '.env' e configure seus valores locais.
# ATENÇÃO: NUNCA versione o arquivo '.env' real com credenciais de produção.
# ==============================================================================

# Porta do Servidor Web Local (Padrão: 8000)
PORT=8000

# Caminho do Banco de Dados SQLite Local
# Para testes e ambiente de desenvolvimento local
DB_PATH=colaboradores.db

# Credenciais Iniciais de Demonstração / Provisionamento Seguro
# IMPORTANTE: Altere estas senhas antes de implantar em qualquer ambiente compartilhado!
ADMIN_INITIAL_PASSWORD=Admin@RH2026!
GUEST_INITIAL_PASSWORD=Visitante@RH2026!

# Integração com Banco de Dados PostgreSQL / Supabase (Opcional - Dual-Mode)
# Formato: postgresql://postgres:[SUA_SENHA]@[HOST]:5432/postgres
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/rh_db

# Chave Secreta para Assinatura de Sessões / Tokens (Produção)
# Gere uma chave aleatória segura com: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=sua_chave_secreta_super_segura_aqui_substitua_em_producao

# Configuração de Ambiente ('development', 'staging', 'production')
ENVIRONMENT=development
